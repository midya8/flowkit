{
  "name": "nightly-etl",
  "env": {
    "DATA_DIR": "/data/nightly"
  },
  "steps": [
    {
      "name": "extract",
      "command": "python extract.py --out ${DATA_DIR}",
      "timeout_seconds": 300
    },
    {
      "name": "transform",
      "command": "python transform.py --in ${DATA_DIR}",
      "depends_on": [
        "extract"
      ],
      "retries": 2,
      "timeout_seconds": 600
    },
    {
      "name": "load",
      "command": "python load.py ${DATA_DIR}",
      "depends_on": [
        "transform"
      ],
      "retries": 2,
      "timeout_seconds": 600
    },
    {
      "name": "notify",
      "command": "./notify.sh ${CHANNEL} 'nightly-etl FAILED'",
      "env": {
        "CHANNEL": "#data-ops"
      },
      "trigger": "on_failure"
    },
    {
      "name": "announce",
      "command": "./notify.sh ${CHANNEL} 'nightly-etl OK'",
      "trigger": "on_success",
      "env": {
        "CHANNEL": "#data-ops"
      }
    },
    {
      "name": "cleanup",
      "command": "rm -rf ${DATA_DIR}/scratch",
      "trigger": "finally"
    }
  ]
}
